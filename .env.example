# -------------------------------------------------------------
# Knowvexa AI — Environment Configuration Example
# -------------------------------------------------------------

# Supabase Configuration
# Optional in Demo Mode. When configured, enables real persistent Auth and PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API
# Optional. If absent, Knowvexa AI operates in Demo AI mode with intelligent educational fallbacks.
GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
